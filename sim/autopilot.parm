# Autopilot (ArduPilot SITL) parameters, loaded by sim/run_sitl.sh.
# Applied as defaults: after editing, restart once with -w.

# Battery: the env sim publishes BATTERY_STATUS 0/1/2 itself, so SITL's own is off
BATT_MONITOR 0

# Starlink power relay on output 9 (service sends DO_SET_SERVO 9 1900=on / 1100=off)
SERVO9_FUNCTION 0
SERVO9_TRIM 1900

# Service loss -> HOLD. The low-power service is the autopilot's "GCS" (sysid 200, 1 Hz heartbeat from
# service/bridge.py). No heartbeat from sysid 200 for FS_TIMEOUT s -> FS_ACTION. MAVProxy/QGC heartbeats
# (sysid 255) don't count, so a dead service is never hidden by a ground station.
MAV_GCS_SYSID 200
FS_GCS_ENABLE 1
FS_TIMEOUT 5          # s (shared with the RC failsafe)
FS_ACTION 2           # 2 = Hold
FS_THR_ENABLE 0       # no RC radio in sim

# Scout cruises at ~1 m/s (mission data); SITL's default is much faster
WP_SPEED 1.0
CRUISE_SPEED 1.0

# Water current ("tide"): the motorboat frame defaults to 0.5 m/s from the north. Off for now, so the
# planner's motor model (speed through water) matches the sim. Wind and waves keep their defaults.
SIM_TIDE_SPEED 0

# Dataflash logs off: the default logs everything and filled sitl_run/logs with ~8 GB of .BIN files
# nothing reads. Set a small mask (e.g. 1) if you ever need them in MAVExplorer.
LOG_BITMASK 0
