// Forecast model (forecast/model.py)
digraph forecast {
  rankdir=TB; nodesep=0.5; ranksep=0.5;
  graph [fontname="Helvetica", fontsize=18, labeljust=l];
  node  [shape=box, style="rounded,filled", fillcolor=white, fontname="Helvetica", fontsize=16, width=3.5];
  edge  [fontname="Helvetica", fontsize=13, fontcolor="#1a5fb4", color=gray35, penwidth=1.3, arrowsize=0.7];
  mission [label="Mission\nmode · speed", fillcolor="#fef7e0"];
  plan    [label="Starlink\nschedule", fillcolor="#fef7e0"];
  sun     [label="Solar\nforecast", fillcolor="#fef7e0"];
  load  [label="Load\n10 + 22·Starlink + k·v² W"];
  solar [label="Solar\none curve per day"];
  batt  [label="Battery\nenergy in − out → V", fillcolor="#e8f0fe"];
  out   [label="Voltage every minute"];
  mission -> load; plan -> load; sun -> solar;
  load -> batt; solar -> batt; batt -> out;
}
