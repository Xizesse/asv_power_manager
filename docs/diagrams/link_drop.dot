// Link drop (service/links.py)
digraph link_drop {
  rankdir=TB; nodesep=0.5; ranksep=0.5;
  graph [fontname="Helvetica", fontsize=18, labeljust=l];
  node  [shape=box, style="rounded,filled", fillcolor=white, fontname="Helvetica", fontsize=16, width=3.5];
  edge  [fontname="Helvetica", fontsize=13, fontcolor="#1a5fb4", color=gray35, penwidth=1.3, arrowsize=0.7];
  a [label="Records queued every minute"];
  b [label="Link down", fillcolor="#fde2e1"];
  c [label="Keep queuing · keep following the plan\nstart / abort still arrive on the other link"];
  d [label="Link back", fillcolor="#e6f4ea"];
  e [label="Queue drains, oldest first"];
  a -> b -> c -> d -> e;
  c -> c [label="  retry ~1 s", style=dashed];
}
